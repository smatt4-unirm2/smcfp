/event/verbose 0          # Nessun output per singolo evento
/tracking/verbose 0       # Nessun output per step

/run/initialize           # Inizializza geometria e fisica

/gun/particle e-          # Particella primaria: elettrone
/gun/energy 1 GeV         # Energia del primario
/gun/position 0 0 -10 cm  # Posizione iniziale (10 cm prima lungo z)
/gun/direction 0 0 1      # Direzione lungo +z
/gun/time 0 ns            # Tempo iniziale
/gun/polarization 0 0 0   # Polarizzazione nulla
/gun/number 1             # 1 particella per evento

/run/printProgress 1000   # Stampa progresso ogni 1000 eventi
/run/beamOn 10000         # Numero di eventi (10k)
