# flair project file
Version: 300
Mode: fluka
Title: Water Bragg Peak
md5: a1dd0ebc2853e18864d64bd3385a4847
Input:
TITLE
	Water Bragg Peak
#define Eb -200.E-3
#define E_min 1.0E-5
#define E_max 220.E-3
* Set the defaults for precision simulations
DEFAULTS PRECISIO
* Define the beam characteristics
BEAM PROTON $Eb,,, 5.0 0 -1.0
	@select=1
BEAMPOS , 0.0 0.0 -2.5
GEOBEGIN COMBNAME
	Water Phantom
RPP BHbox -50. 50. -50. 50. -50. 50.
RPP airbox -45. 45. -45. 45. -45. 45.
RPP W_ph -17.5 17.5 -17.5 17.5 0.0 38.0
END
REGION r_BH 5
	+BHbox -airbox -W_ph 
REGION r_air 5
	+airbox-W_ph
REGION reg_W 5
	+W_ph
END
GEOEND
*276 Water liquid H2O
*Chemical Formula:  H -- O -- H
MATERIAL WATER,,, 1.0
COMPOUND WATER 2.0 HYDROGEN 1.0 OXYGEN
ASSIGNMA , BLCKHOLE r_BH r_BH
ASSIGNMA , AIR r_air r_air
ASSIGNMA , WATER reg_W reg_W
!FLUKAFIX , 0.01
DETECT Ed_W -1024 $E_min $E_max,,, reg_W
USRBIN Ed 10 ENERGY -56 17.5 17.5 38.0 -17.5 -17.5 0.0 350 350 380
USRBIN Dose 10 DOSE -58 17.5 17.5 38.0 -17.5 -17.5 0.0 350 350 380
!EVENTBIN Eb_A 11.0 ENERGY -58 0.35 0.0 3.0 0. 0.0 0.0 1 1 1000
!USERDUMP udamp 100 60 0
* Set the random number seed
RANDOMIZ , 1.0
* Set the number of primary histories to be simulated in the run
START , 1.E+05,,, 0
STOP
EndInput

Page: Plot
plotengine: Gnuplot

